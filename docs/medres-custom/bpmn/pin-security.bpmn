<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="PinSecurity" name="PIN Security Flow" isExecutable="false">
    <bpmn:startEvent id="StartAppResume" name="App comes to foreground">
      <bpmn:outgoing>Flow_CheckAuth</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_AuthState" name="User logged in?">
      <bpmn:incoming>Flow_CheckAuth</bpmn:incoming>
      <bpmn:outgoing>Flow_NormalFlow</bpmn:outgoing>
      <bpmn:outgoing>Flow_PINSetCheck</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="NormalFlow" name="Allow normal flow">
      <bpmn:incoming>Flow_NormalFlow</bpmn:incoming>
      <bpmn:outgoing>Flow_EndNormal</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndNormal" name="Proceed">
      <bpmn:incoming>Flow_EndNormal</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_PINSetCheck" name="PIN set?">
      <bpmn:incoming>Flow_PINSetCheck</bpmn:incoming>
      <bpmn:outgoing>Flow_ShowPINScreen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="ShowPINScreen" name="Show PIN Entry Screen">
      <bpmn:incoming>Flow_ShowPINScreen</bpmn:incoming>
      <bpmn:outgoing>Flow_UserEntersPIN</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="UserEntersPIN" name="User enters 4-digit PIN">
      <bpmn:incoming>Flow_UserEntersPIN</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitPIN</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ValidatePIN" name="Compare with stored hash" implementation="external">
      <bpmn:incoming>Flow_SubmitPIN</bpmn:incoming>
      <bpmn:outgoing>Gateway_IsCorrect</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_IsCorrect" name="PIN correct?">
      <bpmn:incoming>Flow_IsCorrect</bpmn:incoming>
      <bpmn:outgoing>Flow_1ca0sg4</bpmn:outgoing>
      <bpmn:outgoing>Flow_1sj9uh0</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="ResetAttempts" name="Reset attempt counter to 0">
      <bpmn:incoming>Flow_1ca0sg4</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckSoftExpiry</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_SoftExpiry" name="Soft expiry active? (6 hr grace)">
      <bpmn:incoming>Flow_CheckSoftExpiry</bpmn:incoming>
      <bpmn:outgoing>Flow_AllowAccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_13zajna</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="AllowAccess" name="Allow access to app">
      <bpmn:incoming>Flow_AllowAccess</bpmn:incoming>
      <bpmn:outgoing>Flow_EndAccess</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="TriggerReAuth" name="Trigger re-auth flow">
      <bpmn:incoming>Flow_13zajna</bpmn:incoming>
      <bpmn:outgoing>Flow_EndReAuth</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndAccess" name="User can use app">
      <bpmn:incoming>Flow_EndAccess</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndReAuth" name="Re-auth required">
      <bpmn:incoming>Flow_EndReAuth</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="IncrementAttempts" name="Increment failed attempts">
      <bpmn:incoming>Flow_1sj9uh0</bpmn:incoming>
      <bpmn:outgoing>Flow_03xi5uj</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_MaxAttempts" name="Attempts = 3?">
      <bpmn:incoming>Flow_03xi5uj</bpmn:incoming>
      <bpmn:outgoing>Flow_1oxf0u1</bpmn:outgoing>
      <bpmn:outgoing>Flow_19ri6si</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="ReturnValidationError" name="Return validation error">
      <bpmn:incoming>Flow_1oxf0u1</bpmn:incoming>
      <bpmn:outgoing>Flow_LoopToPINScreen</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="TriggerWipe" name="Trigger security wipe">
      <bpmn:incoming>Flow_19ri6si</bpmn:incoming>
      <bpmn:outgoing>Flow_ClearTokens</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ClearAuthTokens" name="Clear auth tokens">
      <bpmn:incoming>Flow_ClearTokens</bpmn:incoming>
      <bpmn:outgoing>Flow_ClearPINData</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ClearPINData" name="Clear PIN hash and salt">
      <bpmn:incoming>Flow_ClearPINData</bpmn:incoming>
      <bpmn:outgoing>Flow_DeleteForms</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="DeleteForms" name="Delete forms">
      <bpmn:incoming>Flow_DeleteForms</bpmn:incoming>
      <bpmn:outgoing>Flow_GoToLogin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndGoToLogin" name="Return to login screen">
      <bpmn:incoming>Flow_GoToLogin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CheckAuth" sourceRef="StartAppResume" targetRef="Gateway_AuthState" />
    <bpmn:sequenceFlow id="Flow_NormalFlow" name="No" sourceRef="Gateway_AuthState" targetRef="NormalFlow" />
    <bpmn:sequenceFlow id="Flow_PINSetCheck" name="Yes" sourceRef="Gateway_AuthState" targetRef="Gateway_PINSetCheck" />
    <bpmn:sequenceFlow id="Flow_EndNormal" sourceRef="NormalFlow" targetRef="EndNormal" />
    <bpmn:sequenceFlow id="Flow_ShowPINScreen" name="Yes" sourceRef="Gateway_PINSetCheck" targetRef="ShowPINScreen" />
    <bpmn:sequenceFlow id="Flow_UserEntersPIN" sourceRef="ShowPINScreen" targetRef="UserEntersPIN" />
    <bpmn:sequenceFlow id="Flow_SubmitPIN" sourceRef="UserEntersPIN" targetRef="ValidatePIN" />
    <bpmn:sequenceFlow id="Flow_IsCorrect" sourceRef="ValidatePIN" targetRef="Gateway_IsCorrect" />
    <bpmn:sequenceFlow id="Flow_CheckSoftExpiry" sourceRef="ResetAttempts" targetRef="Gateway_SoftExpiry" />
    <bpmn:sequenceFlow id="Flow_AllowAccess" name="Yes" sourceRef="Gateway_SoftExpiry" targetRef="AllowAccess" />
    <bpmn:sequenceFlow id="Flow_EndAccess" sourceRef="AllowAccess" targetRef="EndAccess" />
    <bpmn:sequenceFlow id="Flow_EndReAuth" sourceRef="TriggerReAuth" targetRef="EndReAuth" />
    <bpmn:sequenceFlow id="Flow_LoopToPINScreen" sourceRef="ReturnValidationError" targetRef="ShowPINScreen" />
    <bpmn:sequenceFlow id="Flow_ClearTokens" sourceRef="TriggerWipe" targetRef="ClearAuthTokens" />
    <bpmn:sequenceFlow id="Flow_ClearPINData" sourceRef="ClearAuthTokens" targetRef="ClearPINData" />
    <bpmn:sequenceFlow id="Flow_DeleteForms" sourceRef="ClearPINData" targetRef="DeleteForms" />
    <bpmn:sequenceFlow id="Flow_GoToLogin" sourceRef="DeleteForms" targetRef="EndGoToLogin" />
    <bpmn:sequenceFlow id="Flow_1ca0sg4" name="Yes" sourceRef="Gateway_IsCorrect" targetRef="ResetAttempts" />
    <bpmn:sequenceFlow id="Flow_1sj9uh0" name="No" sourceRef="Gateway_IsCorrect" targetRef="IncrementAttempts" />
    <bpmn:sequenceFlow id="Flow_03xi5uj" sourceRef="IncrementAttempts" targetRef="Gateway_MaxAttempts" />
    <bpmn:sequenceFlow id="Flow_1oxf0u1" name="No" sourceRef="Gateway_MaxAttempts" targetRef="ReturnValidationError" />
    <bpmn:sequenceFlow id="Flow_19ri6si" name="Yes" sourceRef="Gateway_MaxAttempts" targetRef="TriggerWipe" />
    <bpmn:sequenceFlow id="Flow_13zajna" name="No" sourceRef="Gateway_SoftExpiry" targetRef="TriggerReAuth" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
