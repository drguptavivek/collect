<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="MultiUserPersistence" name="Multi-User Persistence Feature" isExecutable="false">
    <bpmn:startEvent id="StartConfig" name="QR Scan or Manual Config">
      <bpmn:outgoing>Flow_ExtractProject</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="ExtractProjectID" name="Extract Project ID from config">
      <bpmn:incoming>Flow_ExtractProject</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckExists</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ProjectExists" name="Project exists?">
      <bpmn:incoming>Flow_CheckExists</bpmn:incoming>
      <bpmn:outgoing>Flow_133ds76</bpmn:outgoing>
      <bpmn:outgoing>Flow_11bd7w1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="GetODKUUID" name="Get ODK UUID from ProjectsRepository">
      <bpmn:incoming>Flow_133ds76</bpmn:incoming>
      <bpmn:outgoing>Flow_SwitchTo</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="CreateNewProject" name="Create New Project in ODK">
      <bpmn:incoming>Flow_11bd7w1</bpmn:incoming>
      <bpmn:outgoing>Flow_SetupNew</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SwitchToExisting" name="Switch to Existing Project">
      <bpmn:incoming>Flow_SwitchTo</bpmn:incoming>
      <bpmn:outgoing>Flow_PreserveData</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="SetupNewProject" name="Setup New Project">
      <bpmn:incoming>Flow_SetupNew</bpmn:incoming>
      <bpmn:outgoing>Flow_InitData</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="PreserveData" name="Preserve Existing Forms and Instances">
      <bpmn:incoming>Flow_PreserveData</bpmn:incoming>
      <bpmn:outgoing>Flow_Login</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="InitializeData" name="Initialize Empty Project Data">
      <bpmn:incoming>Flow_InitData</bpmn:incoming>
      <bpmn:outgoing>Flow_Login2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="UserLogin" name="User enters credentials">
      <bpmn:incoming>Flow_Login</bpmn:incoming>
      <bpmn:incoming>Flow_Login2</bpmn:incoming>
      <bpmn:outgoing>Flow_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndComplete" name="See Login-Authentication Flow">
      <bpmn:incoming>Flow_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ExtractProject" sourceRef="StartConfig" targetRef="ExtractProjectID" />
    <bpmn:sequenceFlow id="Flow_CheckExists" sourceRef="ExtractProjectID" targetRef="Gateway_ProjectExists" />
    <bpmn:sequenceFlow id="Flow_SwitchTo" sourceRef="GetODKUUID" targetRef="SwitchToExisting" />
    <bpmn:sequenceFlow id="Flow_SetupNew" sourceRef="CreateNewProject" targetRef="SetupNewProject" />
    <bpmn:sequenceFlow id="Flow_PreserveData" sourceRef="SwitchToExisting" targetRef="PreserveData" />
    <bpmn:sequenceFlow id="Flow_InitData" sourceRef="SetupNewProject" targetRef="InitializeData" />
    <bpmn:sequenceFlow id="Flow_Login" sourceRef="PreserveData" targetRef="UserLogin" />
    <bpmn:sequenceFlow id="Flow_Login2" sourceRef="InitializeData" targetRef="UserLogin" />
    <bpmn:sequenceFlow id="Flow_End" sourceRef="UserLogin" targetRef="EndComplete" />
    <bpmn:sequenceFlow id="Flow_133ds76" name="Yes" sourceRef="Gateway_ProjectExists" targetRef="GetODKUUID" />
    <bpmn:sequenceFlow id="Flow_11bd7w1" name="No" sourceRef="Gateway_ProjectExists" targetRef="CreateNewProject" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="MultiUserPersistence">
      <bpmndi:BPMNShape id="Shape_GetODKUUID" bpmnElement="GetODKUUID">
        <dc:Bounds x="450" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_CreateNewProject" bpmnElement="CreateNewProject">
        <dc:Bounds x="450" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SwitchToExisting" bpmnElement="SwitchToExisting">
        <dc:Bounds x="600" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SetupNewProject" bpmnElement="SetupNewProject">
        <dc:Bounds x="600" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PreserveData" bpmnElement="PreserveData">
        <dc:Bounds x="750" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_InitializeData" bpmnElement="InitializeData">
        <dc:Bounds x="750" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserLogin" bpmnElement="UserLogin">
        <dc:Bounds x="900" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ProjectExists" bpmnElement="Gateway_ProjectExists" isMarkerVisible="true">
        <dc:Bounds x="325" y="193" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="385" y="211" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndComplete" bpmnElement="EndComplete">
        <dc:Bounds x="1050" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1031" y="266" width="70" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ExtractProjectID" bpmnElement="ExtractProjectID">
        <dc:Bounds x="192" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartConfig" bpmnElement="StartConfig">
        <dc:Bounds x="92" y="203" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="74" y="243" width="71" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_ExtractProject" bpmnElement="Flow_ExtractProject">
        <di:waypoint x="128" y="220" />
        <di:waypoint x="192" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_CheckExists" bpmnElement="Flow_CheckExists">
        <di:waypoint x="292" y="218" />
        <di:waypoint x="325" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SwitchTo" bpmnElement="Flow_SwitchTo">
        <di:waypoint x="550" y="140" />
        <di:waypoint x="600" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SetupNew" bpmnElement="Flow_SetupNew">
        <di:waypoint x="550" y="340" />
        <di:waypoint x="600" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_PreserveData" bpmnElement="Flow_PreserveData">
        <di:waypoint x="700" y="140" />
        <di:waypoint x="750" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_InitData" bpmnElement="Flow_InitData">
        <di:waypoint x="700" y="340" />
        <di:waypoint x="750" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Login" bpmnElement="Flow_Login">
        <di:waypoint x="850" y="140" />
        <di:waypoint x="900" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Login2" bpmnElement="Flow_Login2">
        <di:waypoint x="850" y="340" />
        <di:waypoint x="900" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_End" bpmnElement="Flow_End">
        <di:waypoint x="1000" y="227" />
        <di:waypoint x="1050" y="227" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_133ds76_di" bpmnElement="Flow_133ds76">
        <di:waypoint x="350" y="193" />
        <di:waypoint x="350" y="140" />
        <di:waypoint x="450" y="140" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="356" y="164" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11bd7w1_di" bpmnElement="Flow_11bd7w1">
        <di:waypoint x="350" y="243" />
        <di:waypoint x="350" y="340" />
        <di:waypoint x="450" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="358" y="289" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
