<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera permission for QR scanner -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Biometric authentication permission -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Device ID for authentication -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application>
        <!-- MEDRES Login Activity - Entry point for authentication -->
        <activity
            android:name=".activities.MedresLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Medres.Auth.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:launchMode="singleTop">

            <!-- Deep linking for authentication -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="medres-auth" />
            </intent-filter>
        </activity>

        <!-- MEDRES QR Scanner Activity - For scanning project configuration QR codes -->
        <activity
            android:name=".activities.MedresQrScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.Medres.Auth.NoActionBar"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true" />

        <!-- PIN Entry Activity - For returning users -->
        <activity
            android:name=".activities.PinEntryActivity"
            android:exported="false"
            android:theme="@style/Theme.Medres.Auth.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- PIN Setup Activity - For new users creating PIN -->
        <activity
            android:name=".activities.SetupPinActivity"
            android:exported="false"
            android:theme="@style/Theme.Medres.Auth.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- PIN Setup Confirmation Activity -->
        <activity
            android:name=".activities.MedresPinSetupConfirmActivity"
            android:exported="false"
            android:theme="@style/Theme.Medres.Auth.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- Forgot PIN Activity - Requires full re-authentication -->
        <activity
            android:name=".activities.MedresForgotPinActivity"
            android:exported="false"
            android:theme="@style/Theme.Medres.Auth.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- Settings Activity - User profile and app settings -->
        <activity
            android:name=".activities.MedresSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Medres.Auth"
            android:parentActivityName=".activities.MedresPinActivity"
            android:screenOrientation="portrait" />

        <!-- Auth Settings Activity - Shows user details, token, logout, etc. -->
        <activity
            android:name=".activities.AuthSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Medres.Auth"
            android:screenOrientation="portrait" />

        <!-- Change PIN Activity - Allows users to change their PIN -->
        <activity
            android:name=".activities.ChangePinActivity"
            android:exported="false"
            android:theme="@style/Theme.Medres.Auth.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait" />

        <!-- Base Activity for shared authentication functionality -->
        <activity
            android:name=".activities.MedresBaseActivity"
            android:exported="false"
            android:theme="@style/Theme.Medres.Auth.NoActionBar"
            android:configChanges="orientation|screenSize|keyboardHidden" />

    </application>
</manifest>