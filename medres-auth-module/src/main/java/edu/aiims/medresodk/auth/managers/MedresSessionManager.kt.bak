package edu.aiims.medresodk.auth.managers

import kotlinx.coroutines.*
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.asStateFlow
import edu.aiims.medresodk.auth.storage.MedresAuthStorage
import edu.aiims.medresodk.auth.utils.MedresConstants
import javax.inject.Inject
import javax.inject.Singleton

/**
 * Manages user session lifecycle and state.
 *
 * Handles session expiration, offline periods, auto-logout,
 * and provides session state observables for UI components.
 */
@Singleton
class MedresSessionManager @Inject constructor(
    private val authManager: MedresAuthManager,
    private val authStorage: MedresAuthStorage,
    private val scope: CoroutineScope
) {

    private val _sessionState = MutableStateFlow(SessionState.ACTIVE)
    val sessionState: Flow<SessionState> = _sessionState.asStateFlow()

    private val _offlineTimeRemaining = MutableStateFlow<Long>(0)
    val offlineTimeRemaining: Flow<Long> = _offlineTimeRemaining.asStateFlow()

    private val _autoLogoutTimeRemaining = MutableStateFlow<Long>(0)
    val autoLogoutTimeRemaining: Flow<Long> = _autoLogoutTimeRemaining.asStateFlow()

    private var sessionCheckJob: Job? = null
    private var lastActivityTime = System.currentTimeMillis()

    init {
        // Start session monitoring
        startSessionMonitoring()
    }

    /**
     * Start monitoring session state.
     */
    private fun startSessionMonitoring() {
        sessionCheckJob?.cancel()

        sessionCheckJob = scope.launch {
            while (isActive) {
                checkSessionState()
                delay(MedresConstants.MINUTE_IN_MS) // Check every minute
            }
        }
    }

    /**
     * Check and update session state.
     */
    private suspend fun checkSessionState() {
        val currentTime = System.currentTimeMillis()

        // Check if authenticated
        if (!authStorage.isAuthenticated) {
            _sessionState.value = SessionState.INVALID
            return
        }

        // Check offline period
        val offlinePeriodMs = authStorage.offlinePeriodDays * MedresConstants.DAY_IN_MS
        val timeSinceAuth = currentTime - authStorage.lastAuthTimestamp
        val offlineRemaining = offlinePeriodMs - timeSinceAuth

        if (offlineRemaining <= 0) {
            _sessionState.value = SessionState.OFFLINE_EXPIRED
            _offlineTimeRemaining.value = 0
            return
        }

        _offlineTimeRemaining.value = offlineRemaining

        // Check auto-logout timeout
        val autoLogoutMs = authStorage.autoLogoutMinutes * MedresConstants.MINUTE_IN_MS
        val timeSinceActivity = currentTime - lastActivityTime
        val logoutRemaining = autoLogoutMs - timeSinceActivity

        if (logoutRemaining <= 0) {
            _sessionState.value = SessionState.AUTO_LOGOUT
            _autoLogoutTimeRemaining.value = 0
            return
        }

        _autoLogoutTimeRemaining.value = logoutRemaining

        // Check token expiry
        if (authStorage.isTokenExpired()) {
            _sessionState.value = SessionState.TOKEN_EXPIRED
            return
        }

        // Check PIN lock
        if (authStorage.isPinLocked()) {
            _sessionState.value = SessionState.PIN_LOCKED
            return
        }

        _sessionState.value = SessionState.ACTIVE
    }

    /**
     * Update last activity timestamp.
     * Call this when user interacts with the app.
     */
    fun updateLastActivity() {
        lastActivityTime = System.currentTimeMillis()
        authStorage.updateLastAuthTimestamp()
    }

    /**
     * Extend session by refreshing token if needed.
     */
    suspend fun extendSession(): Boolean {
        return try {
            if (authStorage.isTokenExpired()) {
                authManager.refreshToken()
            } else {
                true
            }
        } catch (e: Exception) {
            false
        }
    }

    /**
     * Force session expiry (logout).
     */
    fun expireSession() {
        scope.launch {
            authManager.logout()
            _sessionState.value = SessionState.EXPIRED
        }
    }

    /**
     * Get session summary for debugging.
     */
    fun getSessionSummary(): Map<String, Any> {
        val currentTime = System.currentTimeMillis()
        val timeSinceAuth = currentTime - authStorage.lastAuthTimestamp
        val timeSinceActivity = currentTime - lastActivityTime

        return mapOf(
            "sessionState" to _sessionState.value.name,
            "lastAuthTime" to authStorage.lastAuthTimestamp,
            "lastActivityTime" to lastActivityTime,
            "timeSinceAuth" to timeSinceAuth,
            "timeSinceActivity" to timeSinceActivity,
            "offlineTimeRemaining" to _offlineTimeRemaining.value,
            "autoLogoutTimeRemaining" to _autoLogoutTimeRemaining.value,
            "isAuthenticated" to authStorage.isAuthenticated,
            "isTokenExpired" to authStorage.isTokenExpired(),
            "isPinLocked" to authStorage.isPinLocked(),
            "offlinePeriodDays" to authStorage.offlinePeriodDays,
            "autoLogoutMinutes" to authStorage.autoLogoutMinutes
        )
    }

    /**
     * Clear session monitoring.
     */
    fun clear() {
        sessionCheckJob?.cancel()
        _sessionState.value = SessionState.INVALID
    }
}

/**
 * Session states.
 */
enum class SessionState {
    ACTIVE,
    INVALID,
    EXPIRED,
    OFFLINE_EXPIRED,
    AUTO_LOGOUT,
    TOKEN_EXPIRED,
    PIN_LOCKED
}