<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/medres_auth_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_large">

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/logo_view"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="32dp"
            android:contentDescription="@string/medres_app_name"
            android:src="@drawable/medres_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/progress_bar" />

        <TextView
            android:id="@+id/title_text"
            style="@style/TextAppearance.Medres.HeadlineMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="@string/medres_pin"
            android:textAlignment="center"
            android:textColor="@color/medres_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logo_view" />

        <TextView
            android:id="@+id/subtitle_text"
            style="@style/TextAppearance.Medres.BodyLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="@string/medres_enter_pin_message"
            android:textAlignment="center"
            android:textColor="@color/gray_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_text" />

        <TextView
            android:id="@+id/user_text_view"
            style="@style/TextAppearance.Medres.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:textAlignment="center"
            android:textColor="@color/medres_on_surface_variant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subtitle_text"
            tools:text="Welcome back, User" />

        <!-- PIN Input Section (Moved UP) -->
        <TextView
            android:id="@+id/pin_hint"
            style="@style/TextAppearance.Medres.BodyLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:text="@string/medres_pin_hint"
            android:labelFor="@id/pin_field"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/user_text_view" />

        <FrameLayout
            android:id="@+id/pin_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pin_hint">

            <!-- Hidden EditText to collect input -->
            <EditText
                android:id="@+id/pin_field"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:alpha="0"
                android:inputType="number"
                android:maxLength="4"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:background="@null"
                android:cursorVisible="false"
                android:imeOptions="actionDone"
                android:contentDescription="@string/medres_pin_hint" />

            <!-- Visible Squares -->
            <LinearLayout
                android:id="@+id/pin_boxes_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pin_box_1"
                    style="@style/PinBoxStyle"
                    android:text="" />

                <TextView
                    android:id="@+id/pin_box_2"
                    style="@style/PinBoxStyle"
                    android:layout_marginStart="@dimen/pin_box_spacing"
                    android:text="" />

                <TextView
                    android:id="@+id/pin_box_3"
                    style="@style/PinBoxStyle"
                    android:layout_marginStart="@dimen/pin_box_spacing"
                    android:text="" />

                <TextView
                    android:id="@+id/pin_box_4"
                    style="@style/PinBoxStyle"
                    android:layout_marginStart="@dimen/pin_box_spacing"
                    android:text="" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/enter_button"
            android:layout_width="0dp"
            android:layout_height="@dimen/button_height_large"
            android:layout_marginTop="@dimen/margin_large"
            android:text="@string/medres_button_verify"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pin_container" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/forgot_pin_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:text="@string/medres_button_forgot_pin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/enter_button" />

        <!-- Status Container for Permissions (Moved DOWN) -->
        <LinearLayout
            android:id="@+id/permission_status_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_xlarge"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/forgot_pin_button">

            <TextView
                android:id="@+id/location_status_view"
                style="@style/TextAppearance.Medres.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                tools:text="Location Access" />

            <TextView
                android:id="@+id/notification_status_view"
                style="@style/TextAppearance.Medres.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                tools:text="Notifications Enabled" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/grant_permissions_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/medres_button_grant_permissions"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Token Expiry Reminder -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/expiry_reminder_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:visibility="gone"
            android:accessibilityLiveRegion="assertive"
            app:cardBackgroundColor="@color/offline_background"
            app:cardCornerRadius="@dimen/corner_radius_medium"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/permission_status_container"
            app:strokeColor="@color/offline_border"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_medium">

                <TextView
                    android:id="@+id/expiry_reminder_text"
                    style="@style/TextAppearance.Medres.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/medres_token_expiry_reminder"
                    android:textColor="@color/offline_text" />

                <TextView
                    android:id="@+id/expiry_time_text"
                    style="@style/TextAppearance.Medres.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textStyle="bold"
                    android:textColor="@color/offline_text"
                    tools:text="Expires in 12 hours" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/refresh_token_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:text="@string/medres_button_refresh_now"
                    android:textColor="@color/offline_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
