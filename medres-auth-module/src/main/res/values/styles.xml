<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Placeholder styles to avoid resource linking errors -->
    <style name="TextAppearance.Medres.HeadlineLarge" parent="">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Medres.HeadlineMedium" parent="">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Medres.BodyLarge" parent="">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Medres.BodyMedium" parent="">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Medres.BodySmall" parent="">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Medres.TitleMedium" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Medres.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/medres_primary</item>
    </style>

    <style name="Widget.Medres.Button.TextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/medres_primary</item>
    </style>

    <style name="Widget.Medres.Button.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/medres_primary</item>
        <item name="android:textColor">@color/medres_primary</item>
    </style>

    <!-- TextInputLayout with FilledBox style for better visibility -->
    <style name="Widget.Medres.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxStrokeColor">@color/medres_primary</item>
        <item name="hintTextColor">@color/medres_primary</item>
        <item name="boxBackgroundColor">@color/medres_surface</item>
        <item name="android:textColorHint">@color/medres_on_surface_variant</item>
        <item name="startIconTint">@color/medres_on_surface_variant</item>
        <item name="endIconTint">@color/medres_on_surface_variant</item>
    </style>

    <!-- OutlinedBox variant with visible border -->
    <style name="Widget.Medres.TextInputLayout.OutlinedBox" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/medres_primary</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintTextColor">@color/medres_primary</item>
        <item name="boxBackgroundColor">@color/medres_surface</item>
        <item name="android:textColorHint">@color/medres_on_surface_variant</item>
        <item name="startIconTint">@color/medres_on_surface_variant</item>
        <item name="endIconTint">@color/medres_on_surface_variant</item>
    </style>

    <style name="PinBoxStyle">
        <item name="android:layout_width">@dimen/pin_box_size</item>
        <item name="android:layout_height">@dimen/pin_box_size</item>
        <item name="android:background">@drawable/pin_box_background</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/medres_on_surface</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>