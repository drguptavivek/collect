<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="2dp" android:color="@color/aiims_primary" />
            <corners android:radius="@dimen/corner_radius_small" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pin_background" />
            <stroke android:width="1dp" android:color="@color/pin_border" />
            <corners android:radius="@dimen/corner_radius_small" />
        </shape>
    </item>
</selector>
