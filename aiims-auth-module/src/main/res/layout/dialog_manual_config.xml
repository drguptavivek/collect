<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Server Base URL -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/baseUrlLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/aiims_server_base_url"
            app:boxStrokeColor="@color/aiims_primary"
            app:hintTextColor="@color/aiims_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/baseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:textColor="?android:textColorPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Project ID -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/projectIdLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/aiims_project_id_label"
            app:boxStrokeColor="@color/aiims_primary"
            app:hintTextColor="@color/aiims_primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/projectIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="?android:textColorPrimary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dev Server Section (DEBUG only - visibility controlled programmatically) -->
        <LinearLayout
            android:id="@+id/devServerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/aiims_surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/aiims_dev_server_label"
                android:textColor="@color/aiims_warning"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/devServerLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/aiims_dev_server_hint"
                app:boxStrokeColor="@color/aiims_warning"
                app:hintTextColor="@color/aiims_warning">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/devServerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textColor="?android:textColorPrimary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Leave empty to use normal URL. Set IP:PORT to override."
                android:textColor="?android:textColorSecondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
